{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "NEXT_PUBLIC_SITE_URL=https://seiji-torisetsu.pages.dev npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^aichi-seiji-map\\.vercel\\.app$" }],
      "destination": "https://seiji-torisetsu.pages.dev/:path*",
      "permanent": true
    }
  ]
}
